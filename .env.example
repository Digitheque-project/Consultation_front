# Variables NEXT_PUBLIC_* : figées dans le bundle JS au build (à fournir en
# --build-arg au Dockerfile). Origines seules, jamais de chemin : le code
# ajoute le préfixe de chaque route.

# Passerelle unique du CHU : backend consultation (/consultation/api),
# dossier patient (/dossier-patient), hospitalisation (/clinique).
NEXT_PUBLIC_GATEWAY_URL=

# Origine de la page de connexion SSO (sans /login).
NEXT_PUBLIC_AUTH_CLIENT_URL=
