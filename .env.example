# ─────────────────────────────────────────────────────────────────────────
# Copier ce fichier en .env.local (dev) ou fournir ces valeurs en
# --build-arg au Dockerfile (prod) — toutes ces variables NEXT_PUBLIC_*
# sont figées dans le bundle JS au build, jamais lues au runtime.
#
# Règle : chaque variable ne contient QUE l'origine du service (schéma +
# hôte + port), jamais de chemin/préfixe — c'est le code applicatif qui
# connaît et ajoute le chemin de chaque route. Ce fichier ne liste que les
# noms des variables, sans valeur : voir le README pour des exemples.
# ─────────────────────────────────────────────────────────────────────────

# Origine du backend consultation externe (sans /consultation/api — le
# préfixe est ajouté par lib/api/consultation-config.ts)
NEXT_PUBLIC_CONSULTATION_EXTERNE_URL=

# Origine du backend SIH/hospitalisation (websocket "/hospitalisations",
# routes /cpa, /vpa, /patients...). ATTENTION : ce n'est PAS le backend
# consultation externe — ces routes n'existent pas dessus.
# Optionnelle pour un déploiement consultation externe seul : aucune page du
# module ne l'utilise (fonctionnalités héritées du monorepo SIH). Laissée
# vide, seul le websocket hospitalisations échoue, sans impact fonctionnel.
# Sert aussi de repli pour NEXT_PUBLIC_CONSULTATION_EXTERNE_URL si celle-ci
# est absente (voir lib/api/consultation-config.ts).
NEXT_PUBLIC_API_URL=



# Origine du backend du module clinique (hospitalisations)
NEXT_PUBLIC_CLINICAL_API_URL=


# Origine du backend "dossier patient" (historique clinique agrégé sur tout
# le CHU, en LECTURE SEULE depuis ce projet — sans /dossier-patient, ajouté
# par lib/dossier-patient-api.ts). Peut être l'origine directe du service OU
# celle de la passerelle API du CHU (gateway-bwm4.onrender.com, sans suffixe)
# — vérifié fonctionnel pour ce service précis uniquement, voir DEPLOIEMENT.md.
NEXT_PUBLIC_DOSSIER_PATIENT_API_URL=

# Origine du service d'authentification SSO (sans /login — le chemin de la
# page de connexion est ajouté par lib/auth/constants.ts)
NEXT_PUBLIC_AUTH_CLIENT_URL=

# serviceId du service consultation-externe dans le registre service-service
# (identité de ce déploiement, pas une donnée utilisateur — sert à s'auto-
# identifier auprès des autres services, ex. websocket de notification)
NEXT_PUBLIC_CONSULTATION_EXTERNE_SERVICE_ID=

# Identifiant du service hospitalier utilisé par défaut pour le module
# clinique (attribution des demandes) — valeur métier, pas une identité
NEXT_PUBLIC_CLINICAL_DEFAULT_SERVICE_ID=

# Nom alternatif de repli pour NEXT_PUBLIC_CONSULTATION_EXTERNE_URL, lu en
# dernier recours si ni CONSULTATION_EXTERNE_URL ni API_URL ne sont définies
# (voir lib/api/consultation-config.ts) — normalement jamais nécessaire.
# NEXT_PUBLIC_BACKEND_URL=

# ─────────────────────────────────────────────────────────────────────────
# Variable SERVEUR (pas de préfixe NEXT_PUBLIC_) : lue au runtime par les
# Route Handlers (app/api/...), jamais inlinée dans le bundle client — donc
# pas besoin de --build-arg pour celle-ci, un -e/--env-file au démarrage du
# conteneur suffit.
# ─────────────────────────────────────────────────────────────────────────

# Token de service utilisé par les Route Handlers serveur pour appeler le
# backend consultation externe en son propre nom (même secret que
# SERVICE_API_TOKEN côté backend)
SERVICE_API_TOKEN=
