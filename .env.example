# ─────────────────────────────────────────────────────────────────────────
# Copier ce fichier en .env.local (dev) ou fournir ces valeurs en
# --build-arg au Dockerfile (prod) — toutes ces variables NEXT_PUBLIC_*
# sont figées dans le bundle JS au build, jamais lues au runtime.
# ─────────────────────────────────────────────────────────────────────────

# URL du backend consultation externe, AVEC le préfixe /consultation/api
# (utilisée par la plupart des appels REST du module consultation externe)
NEXT_PUBLIC_CONSULTATION_EXTERNE_URL=http://localhost:3333/consultation/api

# URL NUE du même backend (SANS /consultation/api) — requise séparément
# par le websocket hospitalisations (socket-notification-provider) et
# plusieurs services clients (patients, prise-en-charge, dossier patient).
NEXT_PUBLIC_API_URL=http://localhost:3333

# URL du backend de prescription para-clinique
NEXT_PUBLIC_PRESCRIPTION_URL=http://localhost:3001

# URL du backend de la pharmacie (routes à la racine, pas de préfixe /pharmacie/api)
NEXT_PUBLIC_PHARMACIE_URL=https://pharmacie-back-1.onrender.com

# URL du backend du module clinique (hospitalisations)
NEXT_PUBLIC_CLINICAL_API_URL=http://localhost:3333

# URL du service de notification temps réel (WebSocket + REST)
NEXT_PUBLIC_NOTIFICATION_URL=http://localhost:3005

# URL du service d'authentification (page de login SSO)
NEXT_PUBLIC_AUTH_CLIENT_URL=https://auth-client-dun.vercel.app/login

# serviceId du service consultation-externe dans le backend de prescription
# (registre service-service — utilisé pour sonder les notifications entrantes)
NEXT_PUBLIC_CONSULTATION_EXTERNE_SERVICE_ID=

# Identifiant du service hospitalier utilisé par défaut pour le module
# clinique (attribution des demandes)
NEXT_PUBLIC_CLINICAL_DEFAULT_SERVICE_ID=

# Nom alternatif de repli pour NEXT_PUBLIC_CONSULTATION_EXTERNE_URL, lu en
# dernier recours si ni CONSULTATION_EXTERNE_URL ni API_URL ne sont définies
# (voir lib/api/consultation-config.ts) — normalement jamais nécessaire.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:3333
